// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Products {
  id             Int              @id(map: "products_pkey") @default(autoincrement())
  sku            String           @unique(map: "products_sku_key")
  name           String
  stockMovements StockMovements[]

  @@check(expression: "(length(TRIM(BOTH FROM name)) > 0)", map: "products_name_check")
  @@check(expression: "(length(TRIM(BOTH FROM sku)) > 0)", map: "products_sku_check")
  @@map("products")
}

model StockMovements {
  id         Int         @id(map: "stock_movements_pkey") @default(autoincrement())
  productId  Int         @map("product_id")
  quantity   Int
  _type      String      @map("type")
  occurredAt Timestamptz @map("occurred_at")
  product    Products    @relation(fields: [productId], references: [id], map: "stock_movements_product_id_fkey")

  @@index([productId], map: "idx_stock_movements_product_id")
  @@check(expression: "(quantity > 0)", map: "stock_movements_quantity_check")
  @@check(expression: "(type = ANY (ARRAY['IN'::text, 'OUT'::text]))", map: "stock_movements_type_check")
  @@map("stock_movements")
}
